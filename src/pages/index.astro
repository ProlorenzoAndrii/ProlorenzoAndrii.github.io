---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Header from '../components/Header.astro';
import MapSection from '../components/MapSection.astro';
import BillboardPanel from '../components/BillboardPanel.astro';
import Footer from '../components/Footer.astro';
import ImageModal from '../components/ImageModal.astro';
import { getBillboards } from '../lib/billboards';

const billboards = await getBillboards();
---

<Layout title="Політорг-ІВ — Карта розміщення білбордів">
  <Hero billboards={billboards} />
  <Header />
  <MapSection />
  <BillboardPanel billboards={billboards} />
  <Footer />
  <ImageModal />

  <script type="application/json" id="billboard-data" set:html={JSON.stringify(billboards)} />

  <script>
    import '../scripts/map.ts';
  </script>
</Layout>

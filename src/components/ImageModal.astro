---
---

<div id="image-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <button class="modal-close" aria-label="Закрити">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    <img id="modal-image" src="" alt="" />
  </div>
</div>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    max-width: 90vw;
    max-height: 85vh;
    transform: scale(0.92);
    transition: transform var(--transition-base);
  }

  .modal[aria-hidden="false"] .modal-content {
    transform: scale(1);
  }

  .modal--instant,
  .modal--instant .modal-content {
    transition: none;
  }

  .modal-content img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    object-fit: contain;
  }

  .modal-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    color: white;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.15);
  }
</style>

<script>
  import { withViewTransition } from '../scripts/view-transition';

  interface OpenImageDetail {
    src: string;
    alt: string;
    preview?: string;
    origin?: HTMLImageElement | null;
  }

  function initModal() {
    const modal = document.getElementById('image-modal')!;
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const backdrop = modal.querySelector('.modal-backdrop')!;
    const closeBtn = modal.querySelector<HTMLButtonElement>('.modal-close')!;

    let origin: HTMLImageElement | null = null;

    const isOpen = () => modal.getAttribute('aria-hidden') === 'false';

    function show(src: string, alt: string) {
      modalImage.src = src;
      modalImage.alt = alt;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function hide() {
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // The morph needs both ends painted at once, so the modal's own fade is switched off meanwhile.
    function morph(update: () => void, from: HTMLElement | null, to: HTMLElement | null) {
      if (from) from.style.viewTransitionName = 'bb-photo';
      modal.classList.add('modal--instant');
      return withViewTransition(() => {
        if (from) from.style.viewTransitionName = '';
        update();
        if (to) to.style.viewTransitionName = 'bb-photo';
      }, ['photo-zoom']).then(() => {
        if (to) to.style.viewTransitionName = '';
        modal.classList.remove('modal--instant');
      });
    }

    function open({ src, alt, preview, origin: from }: OpenImageDetail) {
      origin = from?.isConnected ? from : null;
      if (!origin || !preview) {
        show(src, alt);
        closeBtn.focus();
        return;
      }

      const full = new Image();
      full.src = src;

      morph(() => show(preview, alt), origin, modalImage).then(() => {
        full.decode().then(
          () => {
            if (isOpen()) modalImage.src = src;
          },
          () => {},
        );
        closeBtn.focus();
      });
    }

    function close() {
      if (!isOpen()) return;
      const target = origin?.isConnected ? origin : null;
      origin = null;
      if (!target) {
        hide();
        return;
      }
      morph(hide, modalImage, target).then(() => {
        target.closest<HTMLElement>('button')?.focus({ preventScroll: true });
      });
    }

    backdrop.addEventListener('click', close);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    window.addEventListener('open-image', (e) => open((e as CustomEvent<OpenImageDetail>).detail));
  }

  initModal();
</script>

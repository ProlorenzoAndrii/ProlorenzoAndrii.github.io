---
---

<section id="map-section" class="map-wrapper" aria-label="Карта білбордів">
  <div id="map"></div>

  <button
    id="toggle-panel"
    class="toggle-btn"
    aria-label="Показати список білбордів"
    aria-controls="billboard-panel"
    aria-expanded="false"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>
</section>

<style>
  .map-wrapper {
    position: relative;
    width: 100%;
    height: 100vh;
    z-index: var(--z-map);
    scroll-snap-align: start;
    background: var(--bg-deep);
  }

  #map {
    width: 100%;
    height: 100%;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* clip-path (not transform) so Mapbox's pointer maths and marker positions stay exact. */
      .map-wrapper {
        view-timeline: --map-view block;
        animation: map-reveal linear both;
        animation-timeline: --map-view;
        animation-range: entry 0% entry 100%;
      }

      .map-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        background: var(--bg-deep);
        pointer-events: none;
        animation: map-veil linear both;
        animation-timeline: --map-view;
        animation-range: entry 15% entry 95%;
      }
    }
  }

  @keyframes map-reveal {
    from {
      clip-path: inset(14% 7% 0 7% round 40px);
    }
    to {
      clip-path: inset(0 0 0 0 round 0);
    }
  }

  @keyframes map-veil {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
    }
  }

  .map-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(3, 14, 8, 0.5) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .toggle-btn {
    position: fixed;
    top: 4.25rem;
    left: 1rem;
    z-index: calc(var(--z-panel) + 1);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(var(--surface-rgb), 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(var(--accent-rgb), 0.15);
    color: rgba(255, 255, 255, 0.75);
    transition:
      background var(--transition-fast),
      transform var(--transition-fast),
      left var(--transition-slow);
  }

  .toggle-btn:hover {
    background: rgba(var(--surface-rgb), 0.9);
    transform: scale(1.05);
    color: #fff;
  }

  .toggle-btn.shifted {
    left: calc(var(--panel-width) + 0.75rem);
  }

  /* -- Mapbox controls -- */
  :global(.mapboxgl-ctrl-group) {
    background: rgba(var(--surface-rgb), 0.8) !important;
    border: 1px solid rgba(var(--accent-rgb), 0.15);
    box-shadow: none !important;
  }

  :global(.mapboxgl-ctrl-group button + button) {
    border-top-color: rgba(255, 255, 255, 0.08) !important;
  }

  :global(.mapboxgl-ctrl-group .mapboxgl-ctrl-icon) {
    filter: invert(1) opacity(0.75);
  }

  :global(.mapboxgl-ctrl-bottom-right) {
    bottom: 2.75rem;
  }

  :global(.mapboxgl-ctrl-attrib.mapboxgl-compact) {
    background: rgba(var(--surface-rgb), 0.8);
    color: rgba(255, 255, 255, 0.7);
  }

  :global(.mapboxgl-ctrl-attrib a) {
    color: rgba(var(--accent-soft-rgb), 0.85);
  }

  :global(.mapboxgl-ctrl-attrib-button) {
    filter: invert(1) opacity(0.7);
  }

  /* -- Popup shell -- */
  :global(.mapboxgl-popup) {
    z-index: 5;
  }

  :global(.mapboxgl-popup-tip) {
    border-top-color: var(--popup-bg) !important;
    border-bottom-color: var(--popup-bg) !important;
  }

  :global(.mapboxgl-popup-content) {
    width: min(360px, calc(100vw - 32px));
    padding: 0 !important;
    border-radius: 16px !important;
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(var(--accent-rgb), 0.12),
      0 0 40px rgba(var(--accent-rgb), 0.06) !important;
    overflow: hidden;
    font-family: var(--font-body);
    background: var(--popup-bg) !important;
    color: var(--text);
  }

  :global(.mapboxgl-popup-close-button) {
    font-size: 1.1rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.45);
    right: 0.6rem;
    top: 0.7rem;
    border-radius: 8px;
    transition: background 150ms, color 150ms;
  }

  :global(.mapboxgl-popup-close-button:hover) {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* -- Popup content -- */
  :global(.popup-card) {
    padding: 1rem 1rem 1.1rem;
  }

  :global(.popup-header) {
    padding-right: 2rem;
    margin-bottom: 0.85rem;
  }

  :global(.popup-title-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  :global(.popup-card h3) {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
  }

  :global(.popup-size) {
    flex-shrink: 0;
    padding: 0.1rem 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    color: rgb(var(--accent-soft-rgb));
    background: rgba(var(--accent-rgb), 0.14);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: var(--radius-full);
  }

  :global(.popup-coords) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  :global(.popup-coords:hover) {
    color: rgb(var(--accent-soft-rgb));
  }

  :global(.popup-tabs) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin-bottom: 0.7rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
  }

  :global(.popup-tab) {
    padding: 0.4rem 0;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    border-radius: 7px;
    transition: background 200ms, color 200ms, box-shadow 200ms;
  }

  :global(.popup-tab:hover) {
    color: #fff;
  }

  :global(.popup-tab.is-active) {
    color: #062014;
    background: rgb(var(--accent-rgb));
    box-shadow: 0 0 14px rgba(var(--accent-rgb), 0.35);
  }

  :global(.popup-photo) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    overflow: hidden;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
  }

  :global(.popup-photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease, filter 400ms ease;
  }

  :global(.popup-photo[data-full]:hover img) {
    transform: scale(1.05);
    filter: brightness(1.08);
  }

  :global(.popup-zoom) {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    border-radius: 8px;
    color: #fff;
    opacity: 0.75;
    transition: opacity 200ms;
  }

  :global(.popup-photo:hover .popup-zoom) {
    opacity: 1;
  }

  :global(.popup-photo--stub) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background:
      radial-gradient(circle at 50% 40%, rgba(var(--accent-rgb), 0.14) 0%, transparent 65%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 10px, transparent 10px 20px),
      rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(var(--accent-rgb), 0.25);
  }

  :global(.popup-stub-icon) {
    width: 52px;
    height: 64px;
    color: rgb(var(--accent-rgb));
    filter: drop-shadow(0 0 10px rgba(var(--accent-rgb), 0.4));
  }

  :global(.popup-stub-icon svg) {
    width: 100%;
    height: 100%;
  }

  :global(.popup-stub-text) {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.55);
  }

  :global(.popup-months-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0.75rem 0 0.4rem;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  :global(.popup-months-key) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    text-transform: none;
    letter-spacing: 0;
  }

  :global(.popup-months-key i) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    margin-left: 0.35rem;
  }

  :global(.popup-months-key .key-free) {
    background: rgb(var(--accent-rgb));
  }

  :global(.popup-months-key .key-busy) {
    background: rgba(255, 255, 255, 0.15);
  }

  :global(.popup-months) {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
  }

  :global(.popup-month) {
    padding: 0.28rem 0;
    text-align: center;
    font-size: 0.62rem;
    font-weight: 600;
    border-radius: 5px;
  }

  :global(.popup-month.free) {
    color: #062014;
    background: rgba(var(--accent-rgb), 0.85);
  }

  :global(.popup-month.busy) {
    color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.05);
  }

  /* -- Markers: fixed 28x28, no transforms on the marker element -- */
  :global(.bm) {
    width: 28px;
    height: 28px;
    cursor: pointer;
    outline: none;
  }

  :global(.bm-dot) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(var(--accent-rgb), 0.55);
    background: radial-gradient(circle at 40% 35%, rgba(var(--accent-rgb), 0.3) 0%, rgba(4, 24, 14, 0.85) 100%);
    box-shadow:
      0 0 10px rgba(var(--accent-rgb), 0.3),
      0 0 4px rgba(var(--accent-rgb), 0.15),
      0 2px 6px rgba(0, 0, 0, 0.4);
    transition: box-shadow 250ms ease, border-color 250ms ease;
  }

  :global(.bm:hover .bm-dot),
  :global(.bm:focus-visible .bm-dot) {
    border-color: rgba(var(--accent-soft-rgb), 0.9);
    box-shadow:
      0 0 22px rgba(var(--accent-rgb), 0.6),
      0 0 8px rgba(var(--accent-rgb), 0.3),
      0 2px 8px rgba(0, 0, 0, 0.4);
  }

  :global(.bm-core) {
    position: absolute;
    top: 9px;
    left: 9px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(var(--accent-soft-rgb), 0.8);
    box-shadow: 0 0 6px rgba(var(--accent-rgb), 0.7);
    animation: core-breathe 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes core-breathe {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  :global(.bm-ring) {
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 28px;
    border: 1.5px solid rgba(var(--accent-rgb), 0.35);
    border-radius: 50%;
    animation: ring-pulse 3s ease-out infinite;
    pointer-events: none;
  }

  @keyframes ring-pulse {
    0% { opacity: 0.5; width: 28px; height: 28px; top: 0; left: 0; }
    100% { opacity: 0; width: 52px; height: 52px; top: -12px; left: -12px; }
  }

  :global(.bm-label) {
    position: absolute;
    top: 32px;
    left: 50%;
    margin-left: -55px;
    width: 110px;
    text-align: center;
    padding: 2px 6px;
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 600;
    color: rgb(var(--accent-soft-rgb));
    background: rgba(var(--surface-rgb), 0.8);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(var(--accent-rgb), 0.18);
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.bm:hover .bm-label),
  :global(.bm:focus-visible .bm-label) {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .toggle-btn {
      top: auto;
      bottom: 3.5rem;
      left: 1rem;
    }

    .toggle-btn.shifted {
      left: 1rem;
    }
  }
</style>
